PORT=3000
# 1 = demo mode: fake data, no Boostrify connection (to preview the UI)
DEMO=0
# Company numbers: id:label,id:label  (id = the phone identifier used by Boostrify)
BOOSTRIFY_LINES=966500000001:السعودية 🇸🇦,968900000002:عمان 🇴🇲,964700000003:العراق 🇮🇶

# Public HTTPS URL of this system (needed so Boostrify/Meta can fetch files you upload)
PUBLIC_BASE_URL=https://support.example.com

# Staff login
STAFF_PASSWORD=change-me

# Webhook verification (the same token you enter in Boostrify's webhook settings)
WEBHOOK_VERIFY_TOKEN=change-me-verify-token
# Optional: verifies X-Hub-Signature-256 if Boostrify forwards Meta's signature
WEBHOOK_APP_SECRET=

# --- Boostrify API (adjust to the real documentation) ---
BOOSTRIFY_API_BASE=https://boostrify.pro/api
BOOSTRIFY_API_KEY=
# Phone number ID / sender identifier
BOOSTRIFY_PHONE_ID=
# Endpoint paths (relative to API base). {phone} and {id} are substituted.
BOOSTRIFY_SEND_PATH=/{phone}/messages
BOOSTRIFY_HISTORY_PATH=/{phone}/messages?contact={contact}
BOOSTRIFY_MEDIA_PATH=/{id}
